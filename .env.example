# Copy thành .env; run.py và evals/run_evals.py tự nạp file này.
# Biến đã đặt trong shell được ưu tiên hơn giá trị trong .env.
export PROVIDER=openai
export MODEL=YOUR_TOOL_CALLING_MODEL
export OPENAI_API_KEY=YOUR_KEY
# export GEMINI_API_KEY=YOUR_KEY
# export ANTHROPIC_API_KEY=YOUR_KEY
# export OPENROUTER_API_KEY=YOUR_KEY
# Optional OpenRouter provider slugs (comma-separated); cheapest compatible wins.
# export OPENROUTER_PROVIDER_ONLY=relace/fp4
# Sort all compatible OpenRouter hosts by price, with provider fallbacks.
# export OPENROUTER_PROVIDER_SORT=price
# OpenAI-compatible gateway (PROVIDER=openai):
# export API_KEY=YOUR_KEY
# export API_ENDPOINT=https://your-gateway.example/v1
# export API_MODEL=YOUR_TOOL_CALLING_MODEL
# Optional request pacing, shared between agent and judge (seconds):
# export API_MIN_INTERVAL_SECONDS=5
